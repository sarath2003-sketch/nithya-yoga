# ========================================================
# NITHYA Yoga & Wellness - Environment Configuration
# ========================================================

# Server Port
PORT=8080

# Allowed Frontend Origins (comma separated)
FRONTEND_ORIGIN=http://localhost:8080,https://sarath2003-sketch.github.io

# Public Frontend URL (used to generate shareable class invite links)
FRONTEND_URL=https://sarath2003-sketch.github.io/nithya-yoga/

# Admin Login Credentials
# Default email: admin@nithyayoga.com (or your personal admin email)
ADMIN_EMAIL=admin@nithyayoga.com

# Admin Password Bcrypt Hash
# Default hash below corresponds to: NithyaAdmin2026!
ADMIN_PASSWORD_HASH=$2b$10$kRicDtElpVhRGDavhZKpVO7FgXAG9yJakQj4yBv5i.1gPTxQsWzIy

# JWT Secret for signing member and admin tokens (change to a random 64-char string for production)
JWT_SECRET=nithya_yoga_secure_jwt_secret_key_2026_mindful_wellness_prod

# LiveKit Cloud Credentials (get free credentials from https://cloud.livekit.io)
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# SQLite Database Storage Path
DB_PATH=./nithya-yoga.sqlite
